datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. DYNAMIC CATEGORIES (General Multi-Category)
// ----------------------------------------------------
model Category {
  id          String    @id @default(cuid())
  name        String    // e.g. "Electronics", "Kitchen", "Toys", "Home", "Accessories"
  slug        String    @unique
  description String?   @db.Text
  imageUrl    String?   // Cloudinary image URL
  isFeatured  Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("categories")
}

// ----------------------------------------------------
// 2. PRODUCTS & INVENTORY
// ----------------------------------------------------
enum ProductStatus {
  ACTIVE
  DRAFT
}

model Product {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  description   String         @db.Text
  regularPrice  Decimal        @db.Decimal(10, 2) // Base price (PKR)
  salePrice     Decimal        @db.Decimal(10, 2) // Discounted active price (PKR)
  stockQuantity Int            @default(0)        // Inventory count
  status        ProductStatus  @default(ACTIVE)   // Active or Draft status
  badge         String?                           // e.g. "SALE", "HOT", "NEW"
  isFeatured    Boolean        @default(false)    // Highlight on homepage
  viewsCount    Int            @default(20)

  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  images        ProductImage[]
  orderItems    OrderItem[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([categoryId])
  @@index([slug])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String   // Cloudinary secure URL
  publicId  String   @default("") // Cloudinary public_id for asset management
  alt       String?
  sortOrder Int      @default(0)

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

// ----------------------------------------------------
// 3. GUEST CHECKOUT & ORDER MANAGEMENT
// ----------------------------------------------------
enum PaymentMethod {
  COD
  WHATSAPP
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique // e.g. "2S-1001"

  // Guest Customer Details
  customerName    String
  customerPhone   String
  customerEmail   String?
  shippingAddress String        @db.Text
  city            String
  postalCode      String?
  orderNotes      String?       @db.Text

  // Financial Breakdown
  subtotal        Decimal       @db.Decimal(10, 2)
  shippingFee     Decimal       @default(0.00) @db.Decimal(10, 2) // Free shipping nationwide
  totalAmount     Decimal       @db.Decimal(10, 2)

  paymentMethod   PaymentMethod @default(COD)
  orderStatus     OrderStatus   @default(PENDING)

  items           OrderItem[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderNumber])
  @@index([orderStatus])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName String
  price       Decimal  @db.Decimal(10, 2)
  quantity    Int      @default(1)
  imageUrl    String?
  variantInfo String?

  @@index([orderId])
  @@map("order_items")
}

// ----------------------------------------------------
// 4. STORE SETTINGS
// ----------------------------------------------------
model StoreSetting {
  id               String   @id @default("default")
  storeName        String   @default("2S STORE")
  announcementText String   @default("FREE SHIPPING NATIONWIDE (5-7 WORKING DAYS) • CASH ON DELIVERY AVAILABLE")
  marqueeSpeed     Int      @default(20)
  whatsappNumber   String   @default("923302867560")
  outletBannerText String   @default("🎉 Special Deals & New Arrivals Available Now! ✨")
  updatedAt        DateTime @updatedAt

  @@map("store_settings")
}
